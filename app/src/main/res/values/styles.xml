<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ThemeOverlay.BooksIDontNeed.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.48</item>
        <item name="android:windowAnimationStyle">@style/Animation.BooksIDontNeed.Dialog</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BooksIDontNeed.Dialog</item>
    </style>

    <!-- Material 3 Expressive dialog window animation.
         Enter: spring-inspired scale-up with overshoot + fade
         Exit: crisp scale-down + fade -->
    <style name="Animation.BooksIDontNeed.Dialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <style name="ShapeAppearance.BooksIDontNeed.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
