<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Enhanced Books RecyclerView with Material 3 Expressive animations -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/booksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp"
        android:paddingBottom="80dp"
        android:scrollbars="vertical"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="outsideOverlay"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarTrackVertical="@drawable/scrollbar_track"
        android:fadeScrollbars="true"
        android:scrollbarFadeDuration="300"
        android:scrollbarDefaultDelayBeforeFade="500"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_book_card" />

    <!-- Enhanced Empty State with Material 3 Expressive Design -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Empty State Icon with Enhanced Visual Design -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:alpha="0.8"
                android:contentDescription="@string/empty_state_title"
                android:src="@drawable/ic_book_empty"
                app:tint="?attr/colorOnSurfaceVariant" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/emptyStateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/empty_state_title"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/emptyStateMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/empty_state_message"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="@color/white"
            android:alpha="0.9"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.01" />

    </LinearLayout>

</FrameLayout> 