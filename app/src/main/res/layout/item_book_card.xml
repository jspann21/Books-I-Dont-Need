<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="16dp"
    android:backgroundTint="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="0dp">

    <!-- Main container with enhanced spacing -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Section: Cover Art + Basic Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Enhanced Book Cover -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="90dp"
                android:layout_height="135dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <ImageView
                    android:id="@+id/bookCoverImageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/book_cover_image_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_book_placeholder"
                    tools:src="@drawable/ic_book_placeholder" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Enhanced Book Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title and Menu with improved spacing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/bookTitleTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:lineSpacingExtra="3dp"
                        tools:text="The Great Gatsby" />

                    <ImageButton
                        android:id="@+id/bookMenuButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/book_menu_description"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

                <!-- Enhanced Author -->
                <TextView
                    android:id="@+id/bookAuthorTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp"
                    tools:text="F. Scott Fitzgerald" />

                <!-- Enhanced ISBN Information -->
                <TextView
                    android:id="@+id/bookIsbnTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/isbnTextColor"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:lineSpacingExtra="2dp"
                    tools:text="ISBN-13: 978-0123456789 • ISBN-10: 0123456789"
                    tools:visibility="visible" />

                <!-- Enhanced Category Chip -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/categoryChip"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:clickable="true"
                    android:focusable="true"
                    app:chipBackgroundColor="?attr/colorSecondaryContainer"
                    app:chipStrokeWidth="0dp"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="32dp"
                    app:rippleColor="?attr/colorSecondary"
                    tools:text="Want" />

            </LinearLayout>

        </LinearLayout>

        <!-- Enhanced Pricing Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <!-- Modern Price and Store Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/storeInfoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:backgroundTint="?attr/colorSurfaceContainer"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Enhanced Price Display -->
                        <TextView
                            android:id="@+id/priceTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="2dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="?attr/priceTextColor"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            tools:text="$12.99 - $15.99" />

                        <!-- Enhanced Store Count -->
                        <TextView
                            android:id="@+id/storeCountTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="Available at 3 stores" />

                    </LinearLayout>

                    <!-- Enhanced View Stores Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewStoresButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/view_stores"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:minWidth="0dp"
                        app:cornerRadius="12dp"
                        android:paddingHorizontal="16dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Enhanced Store Details (Initially Hidden) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/storesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_store_info"
                tools:visibility="visible" />

            <!-- Enhanced Date Added -->
            <TextView
                android:id="@+id/dateAddedTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/dateTextColor"
                android:textSize="12sp"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:alpha="0.8"
                tools:text="Added on Mar 15, 2024" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView> 